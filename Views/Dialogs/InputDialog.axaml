<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Vetala.Views"
        x:DataType="views:InputDialog"
        x:Class="Vetala.Views.InputDialog"
        Title="{Binding Title}"
        Width="400" Height="150"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppSecondary}">
    <Border Padding="20">
        <StackPanel Spacing="16">
            <TextBlock Text="{Binding Prompt}" FontSize="13" Foreground="{DynamicResource AppForeground}"/>
            <TextBox Name="InputTextBox" Text="{Binding InputText}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Click="OnCancelClick" IsCancel="True"/>
                <Button Content="OK" Classes="Primary" Click="OnOkClick" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
