<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vetala.ViewModels"
             xmlns:term="using:Vetala.Views.Panels"
             x:Class="Vetala.Views.BottomPanelView"
             x:DataType="vm:MainWindowViewModel"
             Background="#1E1E1E">
    <Grid RowDefinitions="35, *">
        <!-- Tab Header Bar (VS Code style) -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#1E1E1E" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, *">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0" VerticalAlignment="Stretch">
                    <Border Padding="14,0" VerticalAlignment="Stretch" Background="Transparent">
                        <Border BorderBrush="#0078D4" BorderThickness="0,2,0,0" Padding="0,3,0,0">
                            <TextBlock Text="TERMINAL" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                        </Border>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0" HorizontalAlignment="Right">
                    <Button Padding="2" Background="Transparent" BorderThickness="0" Width="20" Height="20" CornerRadius="3"
                            Click="OnNewTerminalClick" ToolTip.Tip="New Terminal">
                        <TextBlock Text="+" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888888"/>
                    </Button>
                    <Button Padding="2" Background="Transparent" BorderThickness="0" Width="20" Height="20" CornerRadius="3"
                            Click="OnKillTerminalClick" ToolTip.Tip="Kill Terminal">
                        <TextBlock Text="✕" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888888"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Terminal Content -->
        <term:TerminalView Grid.Row="1"
                           x:Name="TerminalView"/>
    </Grid>
</UserControl>
